# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/uems?schema=public"

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=5000
NODE_ENV=development

# Comma-separated list of extra browser origins allowed to call the API (frontend on a different address,
# or Vite's dev server). Not needed when one service serves both the site and the API.
CLIENT_ORIGIN="http://localhost:5173"

# Seed accounts (used by `npm run seed`). Change these before seeding a real server.
# Set SEED_ON_START="true" on a host (with SEED_ADMIN_PASSWORD) to create the admin account and sample events on the next start.
# Remove both once the admin can sign in.
SEED_ADMIN_EMAIL="admin@uni.edu"
SEED_ADMIN_PASSWORD="Admin@12345"

# ---- Optional ----
# Public address of the site, used in links inside emails (password reset, email verification).
# On Render this is detected automatically (RENDER_EXTERNAL_URL).
# APP_URL="https://your-app.onrender.com"

# Email is optional. Without SMTP_HOST nothing is sent: in development the links are printed to the server log.
# To send real email set these and keep the optional "nodemailer" package installed.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="UniEvents <no-reply@example.com>"
# LOG_EMAIL_LINKS="true"     # also print email links in production logs (they contain secrets; off by default)

# `npm run seed` loads demo accounts with PUBLIC passwords and refuses to run when NODE_ENV=production.
# ALLOW_DEMO_SEED="true"
