{
  "name": "UniEvents - Campus Event Platform",
  "short_name": "UniEvents",
  "description": "Discover campus events, register, and check in with a QR ticket.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#4f46e5",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My tickets", "url": "/student/tickets", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Discover events", "url": "/events", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
